@top Program { (entityDecl | attributeDecl | LineComment)* }

entityDecl[@name=entityDecl] {
  Entity Identifier
}

attributeDecl[@name=attributeDecl] {
  Attribute Identifier Identifier ("," Identifier)* AttributeType
}

@tokens {
  Entity { "entity" }
  Attribute { "attribute" }

  AttributeType {
    "PK" | "UK" | "OP" | "DR" | "SP" | "CP"
  }

  Identifier {
    $[A-Za-z_\u{00C0}-\u{10FFFF}]
    $[A-Za-z0-9_\u{00C0}-\u{10FFFF}]*
  }

  LineComment { "//" ![\n]* }
  Newline { $[\n]+ }
  WhiteSpace { $[ \t\r]+ }
}

@skip { WhiteSpace | Newline }
