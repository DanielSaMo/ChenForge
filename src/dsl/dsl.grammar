@top Program { (entityDecl | LineComment)* }

entityDecl[@name=entityDecl] {
  Entity Identifier
}

@tokens {
  Entity { "entity" }
  Identifier {
    $[A-Za-z_\u{00C0}-\u{10FFFF}]
    $[A-Za-z0-9_\u{00C0}-\u{10FFFF}]*
  }
  LineComment { "//" ![\n]* }
  Newline { $[\n]+ }
  WhiteSpace { $[ \t\r]+ }
}

@skip { WhiteSpace | Newline }
