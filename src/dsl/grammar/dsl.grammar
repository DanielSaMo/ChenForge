@top Program { Newline* (Statement Newline+)* Statement? }

Statement {
  Declaration LineComment? | LineComment
}

Declaration {
  entityDecl | attributeDecl
}

entityDecl[@name=entityDecl] {
  Entity Identifier Type
}

attributeDecl[@name=attributeDecl] {
  Attribute EntityRef AttributeName ("," AttributeName)* Type (CompositionArg | CardinalityArg)?
}

EntityRef { Identifier }

AttributeName { Identifier }

CompositionArg { Identifier }

CardinalityArg {
  "(" CardinalityValue "," CardinalityValue ")"
}

CardinalityValue {
  Number
}

@tokens {
  Entity { "entity" }
  Attribute { "attribute" }

  Type {
    "ST" | "WK" | "PK" | "UK" | "OP" | "DR" | "SP" | "CP" | "MV"
  }

  Number {
    "-"? $[0-9]+
  | $[^A-Za-z_\u{00C0}-\u{10FFFF}]? "n" $[^A-Za-z_\u{00C0}-\u{10FFFF}]?
  }

  Identifier {
    $[A-Za-z_\u{00C0}-\u{10FFFF}]
    $[A-Za-z0-9_\u{00C0}-\u{10FFFF}]*
  }

  LineComment { "//" ![\n]* }
  Newline { $[\n]+ }
  WhiteSpace { $[ \t\r]+ }
}

@skip { WhiteSpace }
